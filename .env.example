# ==============================================================================
# Agentic Chatbot Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. vLLM / OpenAI-Compatible LLM Inference Endpoint
# ------------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your_vllm_api_key_or_EMPTY
VLLM_MODEL=your_model_name

# ------------------------------------------------------------------------------
# 2. Ollama Local/Remote Embeddings Service
# Note: Use 127.0.0.1 on Windows instead of localhost to prevent IPv6 latency.
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 3. External API Credentials for Tools
# ------------------------------------------------------------------------------
# Tavily Search API (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key

# Alpha Vantage Stock API (https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Optional OpenWeather API (Default weather uses Open-Meteo, no key needed)
OPENWEATHER_API_KEY=your_openweather_api_key

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration for LangGraph Checkpoints
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

